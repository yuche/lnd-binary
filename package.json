{
  "name": "lnd-install",
  "version": "0.4.0",
  "description": "Download the latest lnd binary",
  "type": "module",
  "main": "./dist/index.mjs",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=4.0.0"
  },
  "scripts": {
    "build": "unbuild",
    "postinstall": "npm run build && node ./dist/bin/lnd-install.mjs"
  },
  "files": [
    ".babelrc",
    "config",
    "src",
    "lib",
    "src"
  ],
  "bin": {
    "lnd-install": "./dist/bin/lnd-install"
  },
  "pre-push": [
    "lint",
    "test"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrfelton/lnd-binary.git"
  },
  "dependencies": {
    "axios": "1.9.0",
    "cacache": "19.0.1",
    "debug": "4.4.0",
    "find-config": "1.0.0",
    "fs-extra": "11.3.0",
    "gunzip-maybe": "1.4.2",
    "hasha": "6.0.0",
    "consola": "3.4.2",
    "tar-fs": "3.0.8",
    "true-case-path": "2.2.1",
    "unzip-stream": "0.3.4"
  },
  "devDependencies": {
    "unbuild": "3.5.0"
  },
  "keywords": [
    "bitcoin",
    "lightning-network",
    "lnd"
  ],
  "author": "Tom Kirkpatrick <tkp@kirkdesigns.co.uk> (http://www.kirkdesigns.co.uk/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mrfelton/lnd-binary/issues"
  },
  "homepage": "https://github.com/mrfelton/lnd-binary"
}
